# Treasury wallet that pays faucet rewards and prediction-market winnings.
# This must be a base58-encoded SECRET key (the full keypair), NOT just the
# public address. Keep this file out of git (.gitignore already covers .env).
# Fund this wallet with both your SPL token AND some SOL for transaction fees.
TREASURY_SECRET_KEY_BASE58=

# ---- Faucet ----
FAUCET_AMOUNT=27624
